NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Fallback Stripe Prices (used when a region-specific ID is missing)
STRIPE_PRICE_MONTHLY=price_monthly_xxx
STRIPE_PRICE_YEARLY=price_yearly_xxx
# Region-specific plan Prices (US / AU / NP / IN / EU / CN). Checkout picks by merchant.country.
# STRIPE_PRICE_MONTHLY_US=price_xxx
# STRIPE_PRICE_YEARLY_US=price_xxx
# STRIPE_PRICE_MONTHLY_AU=price_xxx
# STRIPE_PRICE_YEARLY_AU=price_xxx
# STRIPE_PRICE_MONTHLY_NP=price_xxx
# STRIPE_PRICE_YEARLY_NP=price_xxx
# STRIPE_PRICE_VERIFIED_MONTHLY=price_verified_monthly_xxx
# STRIPE_PRICE_VERIFIED_YEARLY=price_verified_yearly_xxx
# STRIPE_PRICE_VERIFIED_MONTHLY_AU=price_xxx
# STRIPE_PRICE_VERIFIED_YEARLY_AU=price_xxx
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# --- Google Sign-In (real OAuth) ---
# Set OAUTH_DEMO_MODE=true only to allow fake Apple/Microsoft demo tokens.
OAUTH_DEMO_MODE=false
# Web OAuth client ID from Google Cloud Console (also used as GIS client_id).
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Optional: comma-separated web + iOS + Android client IDs accepted as token "aud".
# GOOGLE_CLIENT_IDS=web-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com,android-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Expo / mobile (Expo Go uses web bridge at EXPO_PUBLIC_WEB_URL/auth/google-bridge).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Native client IDs only needed for development/production builds (not Expo Go):
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# Google Cloud Console:
# 1) OAuth consent screen
# 2) Credentials → Create OAuth client → Web → Authorized JS origins: http://localhost:3000
#    Also add your LAN origin for Expo Go, e.g. http://192.168.x.x:3000
# 3) (Optional) iOS client for com.stampperk.app / Android for com.stampperk.app
# 4) Put the Web client ID in GOOGLE_CLIENT_ID + NEXT_PUBLIC_* + EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID

# Optional: Google Maps Platform key (Maps JavaScript API). Super Admin Business Map prefers Google when set; otherwise OpenStreetMap.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Production/staging with Docker Postgres:
# DATABASE_URL=postgresql://stampperk:stampperk@localhost:5432/stampperk?schema=public
